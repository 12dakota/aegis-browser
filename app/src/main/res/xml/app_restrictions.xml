<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Managed App Configurations exposed to MDM systems (Intune, Google Endpoint Management, 
  Workspace ONE, Jamf, etc.). Admins can set these remotely. The browser reads them via 
  RestrictionsManager and applies lockdown / proxy / parental policies.
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Global lockdown switch - when true, browser enters full lockdown mode -->
    <restriction
        android:key="lockdown_enabled"
        android:title="Enable Full Lockdown"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <!-- PAC URL or inline PAC content for the default proxy firewall -->
    <restriction
        android:key="pac_url"
        android:title="PAC File URL"
        android:restrictionType="string"
        android:defaultValue="https://pac.cloudflare-gateway.com/e2950b77bc288e9366bebbcccf1c25a8/WIyYdBdISzKaPnuqVMMyqg" />

    <restriction
        android:key="pac_content"
        android:title="Inline PAC Content (overrides URL)"
        android:restrictionType="string"
        android:defaultValue="" />

    <!-- Force system-wide proxy when app is Device Owner (MDM must grant Device Owner) -->
    <restriction
        android:key="force_system_proxy"
        android:title="Force System Proxy via Device Policy"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <!-- Parental / Enterprise URL filtering -->
    <restriction
        android:key="allowed_domains"
        android:title="Allowed Domains (Whitelist)"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="blocked_categories"
        android:title="Blocked Categories"
        android:restrictionType="string"
        android:defaultValue="adult,gambling" />

    <restriction
        android:key="time_restriction_start"
        android:title="Allowed Hours Start (HH:mm)"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="time_restriction_end"
        android:title="Allowed Hours End (HH:mm)"
        android:restrictionType="string"
        android:defaultValue="" />

    <!-- Feature lockdowns -->
    <restriction
        android:key="disable_downloads"
        android:title="Disable Downloads"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="disable_file_uploads"
        android:title="Disable File Uploads"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="force_safe_search"
        android:title="Force SafeSearch on Google/Bing/YouTube"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="disable_incognito"
        android:title="Disable Incognito / Private Mode"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="organization_id"
        android:title="Organization / Tenant ID"
        android:restrictionType="string"
        android:defaultValue="" />

    <!-- Remote command secret / enrollment token -->
    <restriction
        android:key="mdm_enrollment_token"
        android:title="MDM Enrollment Token"
        android:restrictionType="string"
        android:defaultValue="" />

</restrictions>
